# Environment Variables for Cloudflare Pages Deployment
# Copy this file to .env.local for local development
# For production, set these as secrets in Cloudflare Dashboard or via wrangler CLI

# API Configuration
VITE_API_URL=https://api.example.com
VITE_API_VERSION=v1

# Application Settings
VITE_APP_NAME=Vite React ShadCN App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=A modern React application with Vite and ShadCN

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=false

# Third-party Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Authentication (if using)
VITE_AUTH_DOMAIN=
VITE_AUTH_CLIENT_ID=

# Custom Domain (if applicable)
VITE_CUSTOM_DOMAIN=your-domain.com

# Development/Preview Settings
VITE_DEV_MODE=true
VITE_PREVIEW_MODE=false
